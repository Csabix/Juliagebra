#version 460 core
layout(local_size_x = 32) in;
#include "../../ubo.glsl"

// Input
restrict readonly layout(std430, binding = 0) buffer DistanceBufferIn {
    float in_distances[];
};
restrict readonly layout(std430, binding = 1) buffer ColorTypeBufferIn {
    uint in_color_types[];
};
restrict readonly layout(std430, binding = 2) buffer PositionWidthBufferIn {
    vec4 in_position_widths[];
};
// Output
restrict writeonly layout(std430, binding = 3) buffer PositionDistanceBufferOut {
	vec4 out_position_distances[];
};
restrict writeonly layout(std430, binding = 4) buffer ColorBufferOut {
	uvec2 out_color[];
};
restrict writeonly layout(std430, binding = 5) buffer LightBufferOut {
	vec4 out_lights[];
};
restrict writeonly layout(std430, binding = 6) buffer SDFBufferOut {
	vec4 out_sdf[];
};
restrict writeonly layout(std430, binding = 7) buffer RadiusBufferOut {
	float out_radius[];
};
// Uniforms
layout(location = 5) uniform uint offset;

vec2 OctWrap(vec2 v) {
    return (1.0 - abs(v)) * sign(v);
}

vec2 Encode(vec3 n) {
    n /= dot(abs(n),vec3(1.0));
    n.xy = n.z >= 0.0 ? n.xy : OctWrap(n.xy);
    n.xy = n.xy * 0.5 + 0.5;
    return n.xy;
}

void calcLights(in uint index, in vec3 B, in vec3 C) {
    vec3 CI = normalize(B-C);
    vec3 BE = normalize(B-eye());
    vec3 T = normalize(cross(CI,BE));
    vec3 N = normalize(cross(CI,T));

    mat3 TBN = transpose(mat3(T,CI,N));
    out_lights[index] = vec4(Encode(TBN * light_cam()),Encode(TBN * light_side()));
}

void main() {
	const uint i = gl_GlobalInvocationID.x;
    const uint out_i = i + offset;
    if (i + 3u >= in_position_widths.length()) return;
    const uint output_i = out_i * 5u;
	vec4 A4 = vec4(in_position_widths[i   ].xyz, 1.0);
    vec4 B4 = vec4(in_position_widths[i+1u].xyz, 1.0);
    const float width_pixel = in_position_widths[i+1u].w;
    vec4 C4 = vec4(in_position_widths[i+2u].xyz, 1.0);
    vec4 D4 = vec4(in_position_widths[i+3u].xyz, 1.0);
    calcLights(out_i,B4.xyz,C4.xyz);
    A4 = VP * A4;
    B4 = VP * B4;
    C4 = VP * C4;
    D4 = VP * D4;
    // Clipping
    if (B4.z + B4.w < 0.0 && C4.z + C4.w < 0.0) {
        B4 = vec4(0.0/0.0);
        C4 = vec4(0.0/0.0);
    }

    vec3 color_B = unpackUnorm4x8(in_color_types[i+1u]).xyz;
    vec3 color_C = unpackUnorm4x8(in_color_types[i+2u]).xyz;
    float distace_B = in_distances[i+1u];
    float distace_C = in_distances[i+2u];

    float t0 = B4.z + B4.w;
    float t1 = C4.z + C4.w;
    if(t0 < 0.0){
        B4 = mix(B4, C4, t0 / (t0 - t1));
        distace_B = mix(distace_B, distace_C, t0 / (t0 - t1));
        color_B = mix(color_B, color_C, t0 / (t0 - t1));
    } else if(t1 < 0.0){
        C4 = mix(C4, B4, t1 / (t1 - t0));
        distace_C = mix(distace_C, distace_B, t1 / (t1 - t0));
        color_C = mix(color_C, color_B, t1 / (t1 - t0));
    }
    if (t0 < 0.0 || t1 < 0.0) { // DIRTY FIX
        t0 = B4.x + B4.w;
        t1 = C4.x + C4.w;
        if(t0 < 0.0 && t1 >= 0.0) {
            B4 = mix(B4, C4, t0 / (t0 - t1));
            distace_B = mix(distace_B, distace_C, t0 / (t0 - t1));
            color_B = mix(color_B, color_C, t0 / (t0 - t1));
            A4 = vec4(0.0/0.0);
        } else if(t1 < 0.0 && t0 >= 0.0) {
            C4 = mix(C4, B4, t1 / (t1 - t0));
            distace_C = mix(distace_C, distace_B, t1 / (t1 - t0));
            color_C = mix(color_C, color_B, t1 / (t1 - t0));
            D4 = vec4(0.0/0.0);
        }
    }

    out_color[out_i] = uvec2(packUnorm4x8(vec4(color_B,1.0)),packUnorm4x8(vec4(color_C,1.0)));

    t0 = B4.z + B4.w;
    t1 = A4.z + A4.w;
    if(t1 < 0.0) A4 = mix(A4, B4, t1 / (t1 - t0));

    t0 = C4.z + C4.w;
    t1 = D4.z + D4.w;
    if(t1 < 0.0) D4 = mix(D4, C4, t1 / (t1 - t0));
    // Clipping end

    A4.xyz /= A4.w;
    B4.xyz /= B4.w;
    C4.xyz /= C4.w;
    D4.xyz /= D4.w;

    const vec2 WH = vec2(width(), height());
    // Pixel coordinates
    const vec2 A = fma(A4.xy, vec2(0.5), vec2(0.5)) * WH;
    const vec2 B = fma(B4.xy, vec2(0.5), vec2(0.5)) * WH;
    const vec2 C = fma(C4.xy, vec2(0.5), vec2(0.5)) * WH;
    const vec2 D = fma(D4.xy, vec2(0.5), vec2(0.5)) * WH;

    const vec3 distances = vec3(distance(A,B), distance(C,B), distance(C,D));

    const vec2 AB_dir = (A-B) / distances.x; // A <-- B C D
    const vec2 CB_dir = (C-B) / distances.y; // A B --> C D
    const vec2 DC_dir = (D-C) / distances.z; // A B C --> D

    const vec2 AB_dir_r = vec2( AB_dir.y,-AB_dir.x);
    const vec2 CB_dir_r = vec2(-CB_dir.y, CB_dir.x);
    const vec2 DC_dir_r = vec2(-DC_dir.y, DC_dir.x);

    const vec2 inner_offset_ABC = dot(AB_dir,CB_dir) <= -0.9999 ? CB_dir_r :
        (1.0/dot(AB_dir_r,CB_dir)) * CB_dir + (1.0/dot(CB_dir_r,AB_dir)) * AB_dir;

    const vec2 inner_offset_BCD = dot(-CB_dir,DC_dir) <= -0.9999 ? CB_dir_r :
        (1.0/dot(CB_dir_r,DC_dir)) * DC_dir + (1.0/dot(DC_dir_r,-CB_dir)) * -CB_dir;

    vec2 begin_inner_offset = -CB_dir + CB_dir_r;
    vec2 begin_outer_offset = -CB_dir - CB_dir_r;
    vec2 end_inner_offset   =  CB_dir + CB_dir_r;
    vec2 end_outer_offset   =  CB_dir - CB_dir_r;
    vec2 end_outer_third_offset = vec2(1.0/0.0);

    vec2 sdf_begin = vec2(-width_pixel);
    vec3 sdf_end = vec3(distances.y + width_pixel);
    float third_sdf_side = 1.0/0.0;

    if (!any(isnan(A)) && distances.y > 1.0) {
        if (dot(AB_dir,CB_dir) <= 0.00006) {
            // OBSTUSE
            begin_inner_offset =  inner_offset_ABC;
            begin_outer_offset = -inner_offset_ABC;

            if (dot(AB_dir,CB_dir) <= -0.9999) sdf_begin = vec2(0);
            else sdf_begin = vec2(dot(begin_inner_offset,CB_dir),dot(begin_outer_offset,CB_dir))*width_pixel;
        } else {
            // ACUTE
            float AB_l = distances.x / width_pixel;
            float CB_l = distances.y / width_pixel;
            float ab = abs(dot(inner_offset_ABC,AB_dir));
            float cb = abs(dot(inner_offset_ABC,CB_dir));
            if (ab < AB_l && cb < CB_l) {
                begin_inner_offset = inner_offset_ABC;
                begin_outer_offset = -CB_dir - CB_dir_r;

                if (dot(inner_offset_ABC, AB_dir + CB_dir) < 0.0) {
                    begin_inner_offset = -CB_dir + CB_dir_r;
                    begin_outer_offset = -inner_offset_ABC;
                }
                sdf_begin = vec2(dot(begin_inner_offset,CB_dir),dot(begin_outer_offset,CB_dir))*width_pixel;
            }
        }
    }
    
    if (!any(isnan(D))) {
        if (dot(-CB_dir,DC_dir) <= 0.00006) {
            // OBSTUSE
            end_inner_offset =  inner_offset_BCD;
            end_outer_offset = -inner_offset_BCD;

            if (dot(-CB_dir,DC_dir) <= -0.9999) sdf_end.xy = vec2(distances.y);
            else {
                sdf_end.xy = vec2(dot(end_inner_offset,CB_dir),dot(end_outer_offset,CB_dir)) * width_pixel;
                sdf_end.xy += distances.y;
            }
        } else {
            // ACUTE
            float BC_l = distances.y / width_pixel;
            float DC_l = distances.z / width_pixel;
            float bc = abs(dot(inner_offset_BCD,-CB_dir));
            float dc = abs(dot(inner_offset_BCD,DC_dir));
            if (bc < BC_l && dc < DC_l) {
                end_inner_offset = inner_offset_BCD;
                end_outer_offset = CB_dir - CB_dir_r;
                end_outer_third_offset = -DC_dir - DC_dir_r;

                if (dot(inner_offset_BCD, -CB_dir + DC_dir) < 0.0) {
                    end_inner_offset = CB_dir + CB_dir_r;
                    end_outer_offset = -inner_offset_BCD;
                    end_outer_third_offset = -DC_dir + DC_dir_r;
                }
                third_sdf_side = dot(end_outer_third_offset, CB_dir_r) * width_pixel;

                sdf_end = vec3(dot(end_inner_offset,CB_dir),dot(end_outer_offset,CB_dir),dot(end_outer_third_offset,CB_dir)) * width_pixel;
                sdf_end += distances.y;
            }
        }
    }
    /*
    vec2 length_conversion = 2.0 / WH * width_pixel;
    float reverse = unpackUnorm4x8(in_color_types[i+2u]).a != 0.0 ? -1.0 : 1.0;
    out_position_distances[output_i]    = vec4(fma(length_conversion,begin_inner_offset    ,B4.xy), B4.z, reverse * (distace_B + sdf_begin.x));
    out_position_distances[output_i+1u] = vec4(fma(length_conversion,begin_outer_offset    ,B4.xy), B4.z, reverse * (distace_B + sdf_begin.y));
    out_position_distances[output_i+2u] = vec4(fma(length_conversion,end_inner_offset      ,C4.xy), C4.z, reverse * (distace_B + sdf_end.x));
    out_position_distances[output_i+3u] = vec4(fma(length_conversion,end_outer_offset      ,C4.xy), C4.z, reverse * (distace_B + sdf_end.y));
    out_position_distances[output_i+4u] = vec4(fma(length_conversion,end_outer_third_offset,C4.xy), C4.z, reverse * (distace_B + sdf_end.z));

    out_sdf[output_i]    = vec4(width_pixel,sdf_begin.x       ,width_pixel,distances.y);
    out_sdf[output_i+1u] = vec4(-width_pixel,sdf_begin.y      ,width_pixel,distances.y);
    out_sdf[output_i+2u] = vec4(width_pixel,sdf_end.x         ,width_pixel,distances.y);
    out_sdf[output_i+3u] = vec4(-width_pixel,sdf_end.y        ,width_pixel,distances.y);
    out_sdf[output_i+4u] = vec4(third_sdf_side,sdf_end.z,width_pixel,distances.y);
    */
    vec2 length_conversion = 2.0 / WH * width_pixel;
    float reverse = unpackUnorm4x8(in_color_types[i+2u]).a != 0.0 ? -1.0 : 1.0;

    float dz_per_px = distances.y > 0.0 ? (C4.z - B4.z) / distances.y : 0.0;
    float z0 = B4.z + sdf_begin.x * dz_per_px;
    float z1 = B4.z + sdf_begin.y * dz_per_px;
    float z2 = B4.z + sdf_end.x * dz_per_px;
    float z3 = B4.z + sdf_end.y * dz_per_px;
    float z4 = B4.z + sdf_end.z * dz_per_px;

    out_position_distances[output_i]    = vec4(fma(length_conversion,begin_inner_offset    ,B4.xy), z0, reverse * (distace_B + sdf_begin.x));
    out_position_distances[output_i+1u] = vec4(fma(length_conversion,begin_outer_offset    ,B4.xy), z1, reverse * (distace_B + sdf_begin.y));
    out_position_distances[output_i+2u] = vec4(fma(length_conversion,end_inner_offset      ,C4.xy), z2, reverse * (distace_B + sdf_end.x));
    out_position_distances[output_i+3u] = vec4(fma(length_conversion,end_outer_offset      ,C4.xy), z3, reverse * (distace_B + sdf_end.y));
    out_position_distances[output_i+4u] = vec4(fma(length_conversion,end_outer_third_offset,C4.xy), z4, reverse * (distace_B + sdf_end.z));

    out_sdf[output_i]    = vec4(width_pixel,sdf_begin.x       ,width_pixel,distances.y);
    out_sdf[output_i+1u] = vec4(-width_pixel,sdf_begin.y      ,width_pixel,distances.y);
    out_sdf[output_i+2u] = vec4(width_pixel,sdf_end.x         ,width_pixel,distances.y);
    out_sdf[output_i+3u] = vec4(-width_pixel,sdf_end.y        ,width_pixel,distances.y);
    out_sdf[output_i+4u] = vec4(third_sdf_side,sdf_end.z,width_pixel,distances.y);

    float radius_conversion = 1.0 / P[0][0] * width_pixel / width();
    float dw_per_px = distances.y > 0.0 ? (C4.w - B4.w) / distances.y : 0.0;
    out_radius[output_i]    = (B4.w + sdf_begin.x * dw_per_px) * radius_conversion;
    out_radius[output_i+1u] = (B4.w + sdf_begin.y * dw_per_px) * radius_conversion;
    out_radius[output_i+2u] = (B4.w + sdf_end.x   * dw_per_px) * radius_conversion;
    out_radius[output_i+3u] = (B4.w + sdf_end.y   * dw_per_px) * radius_conversion;
    out_radius[output_i+4u] = (B4.w + sdf_end.z   * dw_per_px) * radius_conversion;
}